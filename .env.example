# Public application URL used for canonical and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project values. Do not commit real keys in any .env file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional best-effort server analytics adapter.
ANALYTICS_ENDPOINT=
